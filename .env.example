# ============================================================
# NovIT — Variables d'environnement
# Copiez ce fichier en .env et renseignez vos valeurs.
# Ne committez JAMAIS le fichier .env.
# ============================================================

# --- Serveur MCP ---
# Hôte et port d'écoute du serveur FastAPI
NOVIT_HOST=127.0.0.1
NOVIT_PORT=8000

# Environnement : development | staging | production
NOVIT_ENV=development

# Niveau de log : DEBUG | INFO | WARNING | ERROR
NOVIT_LOG_LEVEL=INFO

# Dossier de sortie des logs (vide = stdout uniquement)
NOVIT_LOG_DIR=

# --- Cache ---
# TTL par défaut en secondes (3600 = 1h)
NOVIT_CACHE_TTL_DEFAULT=3600
# TTL pour les articles de news (secondes)
NOVIT_CACHE_TTL_NEWS=3600
# TTL pour les profils utilisateur (secondes)
NOVIT_CACHE_TTL_PROFILE=86400

# --- Base de données ---
# Chemin vers la base SQLite (dev)
NOVIT_DB_PATH=./novit.db
# URL PostgreSQL (prod) — laisser vide en dev
NOVIT_DATABASE_URL=

# --- Scraping ---
# Délai minimum entre deux requêtes vers le même domaine (secondes)
NOVIT_SCRAPER_DELAY=1.0
# Timeout par requête HTTP (secondes)
NOVIT_SCRAPER_TIMEOUT=10
# User-Agent envoyé dans les requêtes HTTP
NOVIT_USER_AGENT=NovIT/0.1.0 (veille technologique MCP; contact: votre@email.com)
# Rétention des articles en jours
NOVIT_RETENTION_DAYS=7

# --- Sources externes — clés API ---
# NVD (National Vulnerability Database) — optionnel, augmente le rate limit
NVD_API_KEY=

# GitHub — optionnel, augmente le rate limit (5000 req/h vs 60)
GITHUB_TOKEN=

# --- Sentry (monitoring erreurs) ---
# Laisser vide pour désactiver — aucune erreur n'est envoyée sans DSN.
SENTRY_DSN=
# Fraction des appels d'outils tracés pour la performance (0.0-1.0). 0 = désactivé.
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Profil utilisateur par défaut ---
# ETUDIANT | INGENIEUR
NOVIT_DEFAULT_PROFILE=ETUDIANT
